-		    (user_long_t)lv.lv_error_message, lv.lv_error_message_size);
+		/*
+		 * LINUX64: hosted with amfi_get_out_of_my_way, a process may load any library, as it may run any binary:
+		 * AMFI otherwise rejects the locally built (ad-hoc, linker-signed) Python extension modules a locally built
+		 * python dlopens ("mapping process and mapped file (non-platform) have different Team IDs").
+		 */
+		if (!linux64_amfi_off()) {
+			error = mac_file_check_library_validation(p, fg, lv.lv_file_start,
+			    (user_long_t)lv.lv_error_message, lv.lv_error_message_size);
+		}
 #endif
 
 		break;
