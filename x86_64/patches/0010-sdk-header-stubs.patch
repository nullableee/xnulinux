From 0000000000000000000000000000000000000010 Mon Sep 17 00:00:00 2001
From: xnulinux <xnulinux@local>
Date: Wed, 25 Nov 2026 00:00:00 +0000
Subject: [PATCH] LINUX64: stub missing SDK headers for hosted x86_64 build

The public macOS SDK lacks CoreEntitlements V2 and iig-generated DriverKit
headers. Provide the minimal declarations needed by amfi and libkern C++.

---
 3 files changed, 57 insertions(+)

diff --git a/EXTERNAL_HEADERS/CoreEntitlements/V2/API.h b/EXTERNAL_HEADERS/CoreEntitlements/V2/API.h
new file mode 100644
index 0000000..97e1f1b
--- /dev/null
+++ b/EXTERNAL_HEADERS/CoreEntitlements/V2/API.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * Minimal CoreEntitlements V2 API stub for the hosted x86_64 XNU build.
+ * The private V2 headers are absent from the public SDK; the v1 headers in
+ * EXTERNAL_HEADERS/CoreEntitlements provide the common CE types.
+ */
+#ifndef _CORE_ENTITLEMENTS_V2_API_H_
+#define _CORE_ENTITLEMENTS_V2_API_H_
+
+#include <CoreEntitlements/CoreEntitlements.h>
+
+#endif /* _CORE_ENTITLEMENTS_V2_API_H_ */
diff --git a/EXTERNAL_HEADERS/CoreEntitlements/V2/Kernel.h b/EXTERNAL_HEADERS/CoreEntitlements/V2/Kernel.h
new file mode 100644
index 0000000..796424f
--- /dev/null
+++ b/EXTERNAL_HEADERS/CoreEntitlements/V2/Kernel.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * Minimal CoreEntitlements V2 kernel stub for the hosted x86_64 XNU build.
+ * Only the types referenced by libkern/amfi and the x86_64 code-signing path
+ * are declared here; the hosted kernel does not register a real CE runtime.
+ */
+#ifndef _CORE_ENTITLEMENTS_V2_KERNEL_H_
+#define _CORE_ENTITLEMENTS_V2_KERNEL_H_
+
+#include <CoreEntitlements/CoreEntitlements.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdbool.h>
+
+typedef struct CEContext {
+	uint64_t _opaque[16];
+} CEContext_t;
+
+typedef struct CEKernelAPI {
+	CEError_t (*contextGetLegacyContext)(const CEContext_t *context, CEQueryContext_t *legacy);
+	CEError_t (*contextValueForKey)(const CEContext_t *context, const char *key, void *value);
+	CEError_t (*elementMatchBool)(void *element, bool value);
+	void      (*elementGetCEBuffer)(void *element, void *buffer);
+	CEError_t (*contextInitWithTypeLegacy)(CEContext_t *context, uint32_t type, const void *data, size_t length);
+	bool      (*contextCheckAcceleration)(const CEContext_t *context);
+	CEError_t (*contextEvaluateAcceleration)(const CEContext_t *context, size_t *length);
+	CEError_t (*contextAccelerate)(const CEContext_t *context);
+} CEKernelAPI_t;
+
+#endif /* _CORE_ENTITLEMENTS_V2_KERNEL_H_ */
diff --git a/EXTERNAL_HEADERS/DriverKit/OSObject.h b/EXTERNAL_HEADERS/DriverKit/OSObject.h
new file mode 100644
index 0000000..4bd1b7d
--- /dev/null
+++ b/EXTERNAL_HEADERS/DriverKit/OSObject.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * Minimal DriverKit/OSObject.h stub for the hosted x86_64 XNU build.
+ * The real header and its dispatch structs are generated by iig, which is
+ * unavailable in the CLT runner. libkern defines the kernel OSObject class;
+ * keep the dispatch method structs empty here.
+ */
+#ifndef _DRIVERKIT_OSOBJECT_H_
+#define _DRIVERKIT_OSOBJECT_H_
+
+class OSObject;
+
+struct OSObject_Methods { };
+struct OSObject_KernelMethods { };
+
+#endif /* _DRIVERKIT_OSOBJECT_H_ */
