From 0000000000000000000000000000000000000010 Mon Sep 17 00:00:00 2001
From: xnulinux <xnulinux@local>
Date: Wed, 25 Nov 2026 00:00:00 +0000
Subject: [PATCH] LINUX64: stub missing SDK headers for hosted x86_64 build

The public macOS SDK lacks CodeSignature, CoreEntitlements V2,
iig-generated DriverKit and libfirehose private headers. Provide the minimal
declarations needed by amfi, code signing, libkern C++ and os/log.

---
 23 files changed, 382 insertions(+)

diff --git a/EXTERNAL_HEADERS/CodeSignature/Entitlements.h b/EXTERNAL_HEADERS/CodeSignature/Entitlements.h
new file mode 100644
index 0000000..519b7cd
--- /dev/null
+++ b/EXTERNAL_HEADERS/CodeSignature/Entitlements.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * Minimal CodeSignature/Entitlements.h stub for the hosted x86_64 build.
+ * The public SDK does not ship this private header; only the hardened-browser
+ * entitlement names referenced by kern_exec.c and necp_client.c are needed.
+ */
+#ifndef _CODE_SIGNATURE_ENTITLEMENTS_H_
+#define _CODE_SIGNATURE_ENTITLEMENTS_H_
+
+#define kCSWebBrowserHostEntitlement       "com.apple.webbrowser.host"
+#define kCSWebBrowserGPUEntitlement        "com.apple.webbrowser.gpu"
+#define kCSWebBrowserNetworkEntitlement    "com.apple.webbrowser.network"
+#define kCSWebBrowserWebContentEntitlement "com.apple.webbrowser.webcontent"
+
+#endif /* _CODE_SIGNATURE_ENTITLEMENTS_H_ */
