 		return;
 	}
 
@@ -82,7 +102,7 @@ serial_keyboard_poll(void)
 	uint64_t next;
 
 	while (1) {
-		chr = _serial_getc(false); /* Get a character if there is one */
+		chr = linux64_hook ? linux64_cons_getc() : _serial_getc(false); /* Get a character if there is one */
 		if (chr < 0) { /* The serial buffer is empty */
 			break;
 		}
