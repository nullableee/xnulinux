+/*
+ * LINUX64 (xnulinux): a hosted XNU's console input comes from the host (LINUX64_CALL_CONSOLE_READ), polled by the serial keyboard thread like a UART.
+ */
+static int
+linux64_cons_getc(void)
+{
+	static char buf[64];
+	static int n, i;
+
+	if (i < n) {
+		return (unsigned char)buf[i++];
+	}
+	struct linux64_buf_req q = { .buf = buf, .len = sizeof(buf), .result = 0 };
+	linux64_call(LINUX64_CALL_CONSOLE_READ, &q);
+	n = q.result > 0 ? (int)q.result : 0;
+	i = 0;
+	return n ? (unsigned char)buf[i++] : -1;
+}
+
