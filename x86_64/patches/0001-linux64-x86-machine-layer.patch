diff --git a/osfmk/i386/linux64_x86.c b/osfmk/i386/linux64_x86.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/osfmk/i386/linux64_x86.c
@@ -0,0 +1,135 @@
+/*
+ * LINUX64 (xnulinux), x86_64 machine layer: the XNU side of the hosted state.
+ *
+ * The ARM64 layer keeps its globals in osfmk/arm/arm_init.c and reads CPU
+ * identity from MPIDR. Here the same state is keyed by the x2APIC/APIC ID and
+ * the only architecture-specific exception frame is struct linux64_x86_fault.
+ * Everything the arch-neutral patches call lives here so no other x86 file
+ * needs to know about the host ABI.
+ */
+#include <linux64/linux64_x86_64.h>
+#include <i386/cpu_data.h>
+#include <i386/lapic.h>
+#include <i386/mp.h>
+#include <i386/proc_reg.h>
+#include <kern/debug.h>
+#include <machine/machine_cpu.h>
+#include <pexpert/pexpert.h>
+
+/* Set by xnu.ko before vstart()/i386_init(). */
+unsigned long linux64_hook;
+unsigned long linux64_slide;
+unsigned int linux64_vint[LINUX64_X86_CPU_SLOTS];
+unsigned int linux64_ipi_pending[LINUX64_X86_CPU_SLOTS];
+unsigned long linux64_dbg[LINUX64_NCOUNTERS];
+
+/*
+ * CPUID leaf 1 returns the initial APIC ID in EBX[31:24]. It is available on
+ * every x86_64 CPU and, unlike the local APIC MMIO/x2APIC MSRs, needs no
+ * firmware or EFLAGS state: usable in the first instructions after vstart().
+ */
+unsigned
+linux64_x86_apic_id(void)
+{
+	unsigned int eax, ebx;
+
+	__asm__ volatile ("cpuid"
+	    : "=a" (eax), "=b" (ebx)
+	    : "a" (1), "c" (0));
+	(void)eax;
+	return ebx >> 24;
+}
+
+void
+linux64_assert_report(const char *file, int line, const char *expr)
+{
+	struct linux64_assert_info a = { file, line, expr };
+
+	linux64_call(LINUX64_CALL_ASSERT, &a);
+}
+
+/* In a spin-wait: let the host take this CPU (Linux still owns IRQs). */
+void
+linux64_spin_relax(void)
+{
+	linux64_call2(LINUX64_CALL_PREEMPTED, 1, 0);
+}
+
+int
+linux64_amfi_off(void)
+{
+	static int off = -1;
+
+	if (off < 0) {
+		int v = 0;
+
+		off = PE_parse_boot_argn("amfi_get_out_of_my_way", &v, sizeof(v)) && v != 0;
+	}
+	return off;
+}
+
+/* A CPU this kernel wants to interrupt: the host sets its pending-IPI word. */
+void
+linux64_cpu_signal(unsigned int cpu)
+{
+	linux64_call2(LINUX64_CALL_IPI, (unsigned long)cpu, 0);
+}
+
+/* Called by the machine layer where XNU re-enables interrupts. */
+void
+linux64_ipi_take(void)
+{
+	unsigned int slot = linux64_cpu_slot();
+
