diff --git a/EXTERNAL_HEADERS/linux64/linux64.h b/EXTERNAL_HEADERS/linux64/linux64.h
new file mode 100644
index 0000000..f7e332e
--- /dev/null
+++ b/EXTERNAL_HEADERS/linux64/linux64.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+/*
+ * Compatibility include for arch-neutral xnulinux patch hunks.
+ *
+ * The original ARM64 series includes <linux64/linux64.h>. The x86_64 port
+ * keeps its own ABI header, so this shim lets the same arch-neutral hunks be
+ * applied to both trees without editing them.
+ */
+#ifndef _LINUX64_COMPAT_H_
+#define _LINUX64_COMPAT_H_
+
+#include <linux64/linux64_abi_x86_64.h>
+#include <linux64/linux64_x86_64.h>
+
+#endif /* _LINUX64_COMPAT_H_ */
diff --git a/EXTERNAL_HEADERS/linux64/linux64_abi_x86_64.h b/EXTERNAL_HEADERS/linux64/linux64_abi_x86_64.h
new file mode 100644
index 0000000..ccc7ff6
--- /dev/null
+++ b/EXTERNAL_HEADERS/linux64/linux64_abi_x86_64.h
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: APSL-2.0
+/*
+ * Copyright (c) 2026 xnulinux contributors. All rights reserved.
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_START@
+ * This file contains Original Code and/or Modifications of Original Code as defined in and that are subject to the Apple
+ * Public Source License Version 2.0 (the 'License'). You may not use this file except in compliance with the License.
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_END@
+ */
+/*
+ * The interface between hosted XNU on x86_64 and its Linux host (x86_64/xnu-ko).
+ *
+ * This is deliberately NOT xnu-patches/include/linux64_abi.h. The ARM64 ABI is
+ * keyed by MPIDR, carries PSTATE/ESR/FAR and PAC state, and is read through
+ * TPIDR/SCTLR. The x86_64 ABI is keyed by the local APIC ID, carries CR2/RIP/
+ * error-code fault frames, and is reached through a plain SysV function call.
+ * Call numbers that keep the same semantic meaning keep the same value so the
+ * arch-neutral patches can be shared textually; x86-only calls start at 850.
+ *
+ * Both sides share physical memory: the world page, boot_args, the kernel
+ * collection and all request buffers are mapped in both page tables.
+ * This header includes nothing and is copied into XNU's EXTERNAL_HEADERS.
+ */
+#ifndef _LINUX64_ABI_X86_64_H_
+#define _LINUX64_ABI_X86_64_H_
+
+#define LINUX64_X86_ABI_VERSION 1
+
+enum linux64_call {
+	LINUX64_CALL_KERNEL_TABLES  = 210,	/* a1 = XNU PML4 physical address; host installs shared kernel entries */
+	LINUX64_CALL_IDLE           = 810,	/* a1 = ns to next XNU timer, a2 = pending IPI word for this CPU */
+	LINUX64_CALL_PREEMPTED      = 811,	/* host interrupt pending: a1 = 1 from kernel, 0 from user */
+	LINUX64_CALL_WALLCLOCK      = 812,	/* a1 = u64[2] {seconds, nanoseconds} UTC */
+	LINUX64_CALL_NET_SEND       = 816,	/* a1 = struct linux64_buf_req: one Ethernet frame */
+	LINUX64_CALL_NET_RECV       = 817,	/* a1 = struct linux64_buf_req: one Ethernet frame, result 0 if none */
+	LINUX64_CALL_INPUT_READ     = 818,	/* a1 = struct linux64_buf_req: evdev records */
+	LINUX64_CALL_KEYSTORE_RW    = 819,	/* a1 = struct linux64_rw_req */
+	LINUX64_CALL_DISK_RW        = 820,	/* a1 = struct linux64_rw_req */
+	LINUX64_CALL_DISK_SIZE      = 821,	/* a1 = u64 *: system disk size in bytes */
+	LINUX64_CALL_RANDOM         = 822,	/* a1 = buffer, a2 = length */
+	LINUX64_CALL_HOSTCALL       = 830,	/* a1 = struct linux64_hostcall_req */
+	LINUX64_CALL_CPU_START      = 840,	/* a1 = APIC ID, a2 = cpu_data_t: host enters linux64_cpu_entry(a2) */
+	LINUX64_CALL_IPI            = 841,	/* a1 = target APIC ID: set its pending-IPI word and wake it */
+	LINUX64_CALL_CPU_HALT       = 842,	/* a1 = APIC ID: park a secondary CPU until CPU_START */
+	LINUX64_CALL_FAULT          = 843,	/* a1 = struct linux64_x86_fault: unhandled kernel fault, ends the run */
+	LINUX64_CALL_CONSOLE_READ   = 993,
+	LINUX64_CALL_RAMDISK_RW     = 994,
+	LINUX64_CALL_RAMDISK_SIZE   = 995,
+	LINUX64_CALL_CONSOLE_WRITE  = 996,
+	LINUX64_CALL_ASSERT         = 997,
+	LINUX64_CALL_KPRINTF        = 998,
+	LINUX64_CALL_PANIC          = 999,
+	LINUX64_CALL_USER_ENTER     = 9100,	/* a1 = first user RIP */
+};
+
+struct linux64_buf_req {
+	void *buf;
+	__UINT64_TYPE__ len;
+	__INT64_TYPE__ result;
+};
+
+struct linux64_rw_req {
+	__UINT64_TYPE__ write;
+	__UINT64_TYPE__ off;
+	__UINT64_TYPE__ len;
+	void *buf;
+	__INT64_TYPE__ result;
+};
+
+struct linux64_hostcall_req {
+	const void *req;
+	__UINT64_TYPE__ len;
+	void *reply;
+	__UINT64_TYPE__ max;
+	__INT64_TYPE__ result;
+};
+
+struct linux64_assert_info {
+	const char *file;
+	long line;
+	const char *expr;
+};
+
+struct linux64_input_event {
+	unsigned short type;
+	unsigned short code;
+	int value;
+};
+
+/* x86_64 kernel fault handed to the host (replaces ESR/FAR/SPSR on ARM64). */
+struct linux64_x86_fault {
+	__UINT64_TYPE__ vector;		/* 14 (#PF), 13 (#GP), 6 (#UD), 10 (#TS) */
+	__UINT64_TYPE__ error_code;
+	__UINT64_TYPE__ cr2;
+	__UINT64_TYPE__ rip;
+	__UINT64_TYPE__ rsp;
+	__UINT64_TYPE__ rflags;
+};
+
+/*
+ * Slots are indexed by the x2APIC ID (8 bits is enough for the first port).
+ * The host refuses CPUs whose APIC IDs collide in this table.
+ */
+#define LINUX64_X86_CPU_SLOTS 256
+#define LINUX64_X86_CPU_SLOT(apic_id) ((unsigned)(apic_id) & 0xffu)
+#define LINUX64_CPU_SLOTS LINUX64_X86_CPU_SLOTS
+
+enum linux64_counter {
+	LINUX64_CTR_IDLE_THREAD  = 0,
+	LINUX64_CTR_MACHINE_IDLE = 1,
+	LINUX64_CTR_CPU_IDLE     = 2,
+	LINUX64_CTR_HOST_IDLE    = 3,
+	LINUX64_CTR_SWITCHES     = 4,
+	LINUX64_CTR_LAST_CALL    = 6,
+	LINUX64_CTR_RTCLOCK      = 7,	/* host timer injections */
+	LINUX64_CTR_IPI          = 8,	/* host IPI injections */
+	LINUX64_CTR_THREAD       = 9,
+	LINUX64_CTR_USER_EXC     = 10,	/* exceptions from ring 3 */
+	LINUX64_CTR_USER_VECTOR  = 11,
+	LINUX64_CTR_USER_RIP     = 12,
+	LINUX64_CTR_BAD_VECTOR   = 14,
+	LINUX64_CTR_DUMP_REQ     = 15,
+	LINUX64_NCOUNTERS        = 16,
+};
+
+#endif /* _LINUX64_ABI_X86_64_H_ */
diff --git a/EXTERNAL_HEADERS/linux64/linux64_x86_64.h b/EXTERNAL_HEADERS/linux64/linux64_x86_64.h
new file mode 100644
index 0000000..c27d76f
--- /dev/null
+++ b/EXTERNAL_HEADERS/linux64/linux64_x86_64.h
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: APSL-2.0
+/*
+ * Copyright (c) 2026 xnulinux contributors. All rights reserved.
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_START@
+ * This file contains Original Code and/or Modifications of Original Code as defined in and that are subject to the Apple
+ * Public Source License Version 2.0 (the 'License'). You may not use this file except in compliance with the License.
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_END@
+ */
+/*
+ * XNU-side interface of the x86_64 LINUX64 machine layer.
+ *
+ * Copied with linux64_abi_x86_64.h into XNU's EXTERNAL_HEADERS/linux64. The
+ * names shared with the ARM64 layer (linux64_hook, linux64_vint, ...) are kept
+ * on purpose: the arch-neutral part of the patches can then be applied to both
+ * trees without renaming. All architecture state here is x86_64: APIC ID
+ * slots, a SysV `callq *hook` upcall, GS-based per-CPU data, CR2/RIP faults.
+ *
+ * Hosted or not is decided at run time: linux64_hook is 0 when this kernel
+ * boots on real hardware, and every hosted path is behind `if (linux64_hook)`.
+ */
+#ifndef _LINUX64_X86_64_H_
+#define _LINUX64_X86_64_H_
+
+#include <linux64/linux64_abi_x86_64.h>
+
+#ifndef LINUX64_DEBUG
+#define LINUX64_DEBUG 0
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+extern unsigned long linux64_hook;
+extern unsigned long linux64_slide;
+
+/* APIC ID of this CPU. Implemented by the x86_64 machine-layer patch; before
+ * cpu_data_t exists it reads the local APIC ID register, afterwards it uses
+ * cpu_number()/cpu_data. */
+extern unsigned linux64_x86_apic_id(void);
+static inline unsigned
+linux64_cpu_slot(void)
+{
+	return LINUX64_X86_CPU_SLOT(linux64_x86_apic_id());
+}
+
+/* Virtual interrupt flag: real IF stays clear while XNU runs. */
+extern unsigned int linux64_vint[LINUX64_X86_CPU_SLOTS];
+#define LINUX64_VINT linux64_vint[linux64_cpu_slot()]
+extern unsigned int linux64_ipi_pending[LINUX64_X86_CPU_SLOTS];
+extern unsigned long linux64_dbg[LINUX64_NCOUNTERS];
+
+/*
+ * A plain indirect SysV call: rdi = call, rsi = a1, rdx = a2, rax = return.
+ * Not a function-pointer call from C: the hook is host text in a different
+ * page table/IDT world and must be entered with one explicit instruction.
+ */
+static inline unsigned long
+linux64_call2(enum linux64_call call, unsigned long a1, unsigned long a2)
+{
+	register unsigned long rdi __asm__("rdi") = (unsigned long)call;
+	register unsigned long rsi __asm__("rsi") = a1;
+	register unsigned long rdx __asm__("rdx") = a2;
+	register unsigned long hook __asm__("rax") = linux64_hook;
+
+	linux64_dbg[LINUX64_CTR_LAST_CALL] = (unsigned long)call;
+	if (linux64_hook) {
+		__asm__ volatile ("callq *%3"
+		    : "+r"(rdi), "+r"(rsi), "+r"(rdx), "+r"(hook)
+		    :
+		    : "rcx", "r8", "r9", "r10", "r11", "cc", "memory");
+	}
+	return rdi;
+}
+
+static inline unsigned long
+linux64_call(enum linux64_call call, const void *a1)
+{
+	return linux64_call2(call, (unsigned long)a1, 0);
+}
+
+static inline void
+linux64_random(void *buf, unsigned long len)
+{
+	linux64_call2(LINUX64_CALL_RANDOM, (unsigned long)buf, len);
+}
+
+static inline __UINT64_TYPE__
+linux64_random_uniform(__UINT64_TYPE__ bound)
+{
+	__UINT64_TYPE__ v, limit;
+
+	if (bound == 0) {
+		return 0;
+	}
+	limit = -bound % bound;
+	do {
+		linux64_random(&v, sizeof(v));
+	} while (v < limit);
+	return v % bound;
+}
+
+static inline void
+linux64_count(enum linux64_counter c)
+{
+	linux64_dbg[c]++;
+}
+
+/* Shared with the ARM64 patches (arch-neutral call sites). */
+void linux64_assert_report(const char *file, int line, const char *expr);
+void linux64_ipi_take(void);
+void linux64_cpu_signal(unsigned int cpu);
+void linux64_trust_cache_late_init(void);
+int linux64_amfi_off(void);
+void linux64_dump_threads(void);
+void linux64_spin_relax(void);
+
+/* x86_64-only machine-layer entry points. */
+void linux64_cpu_entry(void *cpu_data) __attribute__((noreturn));
+void linux64_kernel_fault(struct linux64_x86_fault *fault);
+void linux64_user_run(void *saved_state, unsigned long arg) __attribute__((noreturn));
+void linux64_x86_timer(void);
+void linux64_x86_ipi(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _LINUX64_X86_64_H_ */
diff --git a/libkern/crypto/corecrypto_rand.c b/libkern/crypto/corecrypto_rand.c
index d46815b..acea296 100644
--- a/libkern/crypto/corecrypto_rand.c
+++ b/libkern/crypto/corecrypto_rand.c
@@ -27,9 +27,19 @@
  */
 
 #include <libkern/crypto/crypto_internal.h>
+#include <linux64/linux64.h>
 #include <corecrypto/ccrng.h>
+#include <string.h>
 #include <libkern/crypto/rand.h>
 
+/*
+ * LINUX64 (xnulinux): until the corecrypto kext registers g_crypto_funcs (and on a hosted kernel without it), random
+ * bytes come from the host's generator (Linux's get_random_bytes, LINUX64_CALL_RANDOM). A context made before then
+ * holds nothing (linux64_rng_ctx_size).
+ */
+#define linux64_rng_fallback()  (g_crypto_funcs == NULL && linux64_hook != 0)
+#define linux64_rng_ctx_size    (2 * sizeof(uint64_t))
+
 int
 cc_rand_generate(void *out, size_t outlen)
 {
@@ -41,6 +51,9 @@ cc_rand_generate(void *out, size_t outlen)
 		if (rng_state != NULL) {
 			error = ccrng_generate(rng_state, outlen, out);
 		}
+	} else if (linux64_rng_fallback()) {
+		linux64_random(out, outlen);
+		error = 0;
 	}
 
 	return error;
@@ -58,6 +71,10 @@ crypto_random_generate(
 	void *random,
 	size_t random_size)
 {
+	if (linux64_rng_fallback()) {
+		linux64_random(random, random_size);
+		return;
+	}
 	g_crypto_funcs->random_generate_fn(ctx, random, random_size);
 }
 
@@ -67,12 +84,19 @@ crypto_random_uniform(
 	uint64_t bound,
 	uint64_t *random)
 {
+	if (linux64_rng_fallback()) {
+		*random = linux64_random_uniform(bound);
+		return;
+	}
 	g_crypto_funcs->random_uniform_fn(ctx, bound, random);
 }
 
 size_t
 crypto_random_kmem_ctx_size(void)
 {
+	if (linux64_rng_fallback()) {
+		return linux64_rng_ctx_size;
+	}
 	return g_crypto_funcs->random_kmem_ctx_size_fn();
 }
 
@@ -80,5 +104,9 @@ void
 crypto_random_kmem_init(
 	crypto_random_ctx_t ctx)
 {
+	if (linux64_rng_fallback()) {
+		memset(ctx, 0, linux64_rng_ctx_size);
+		return;
+	}
 	g_crypto_funcs->random_kmem_init_fn(ctx);
 }
