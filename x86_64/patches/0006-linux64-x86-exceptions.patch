+			    .cr2        = regs->cr2,
+			    .rip        = regs->isf.rip,
+			    .rsp        = regs->isf.rsp,
+			    .rflags     = regs->isf.rflags,
+			};
+
+			linux64_user_fault(&lx);
+		}
 	} else {
 		x86_saved_state32_t     *regs;
 
@@ -1124,6 +1157,19 @@ user_trap(
 #if DEVELOPMENT || DEBUG
 		traptrace_index = traptrace_start(type, rip, mach_absolute_time(), regs->ebp);
 #endif
+		if (linux64_hook && (type == T_PAGE_FAULT || type == T_GENERAL_PROTECTION ||
+		    type == T_INVALID_OPCODE || type == T_STACK_FAULT)) {
+			struct linux64_x86_fault lx = {
+			    .vector     = (uint64_t)type,
+			    .error_code = regs->err,
+			    .cr2        = regs->cr2,
