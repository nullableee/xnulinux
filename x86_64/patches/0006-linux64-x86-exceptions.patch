 #include <i386/panic_notify.h>
@@ -701,6 +702,25 @@ kernel_trap(
 
 	is_user = (vaddr < VM_MAX_USER_PAGE_ADDRESS);
 
+	/*
+	 * LINUX64 (xnulinux): report a kernel fault to the Linux host before XNU
+	 * panics. The host owns the page tables while XNU is parked, so it is the
+	 * only side that can decide whether this address can be repaired.
+	 */
+	if (linux64_hook && (type == T_PAGE_FAULT || type == T_GENERAL_PROTECTION ||
+	    type == T_INVALID_OPCODE || type == T_STACK_FAULT)) {
+		struct linux64_x86_fault lx = {
+		    .vector     = (uint64_t)type,
+		    .error_code = saved_state->isf.err,
+		    .cr2        = saved_state->cr2,
+		    .rip        = saved_state->isf.rip,
+		    .rsp        = saved_state->isf.rsp,
+		    .rflags     = saved_state->isf.rflags,
+		};
+
+		linux64_kernel_fault(&lx);
+	}
+
 #if DEVELOPMENT || DEBUG
 	uint32_t traptrace_index = traptrace_start(type, kern_ip, mach_absolute_time(), saved_state->rbp);
 #endif
@@ -1109,6 +1129,19 @@ user_trap(
