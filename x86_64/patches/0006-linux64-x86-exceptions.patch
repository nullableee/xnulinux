+static void
+linux64_fault_report(struct linux64_x86_fault *fault, int from_user)
+{
+	if (!linux64_hook || fault == NULL) {
+		return;
+	}
+	linux64_count(from_user ? LINUX64_CTR_USER_EXC : LINUX64_CTR_BAD_VECTOR);
+	/*
+	 * linux64_hook is xnu_world_upcall_x86(): it rediscovers this CPU's world
+	 * from CPUID, switches to Linux's CR3/IDT/stack and calls xnu_hook_x86().
+	 * The host returns nonzero for an unhandled fault, which ends the run.
+	 */
+	linux64_call(LINUX64_CALL_FAULT, fault);
+}
+
 void
 linux64_kernel_fault(struct linux64_x86_fault *fault)
 {
-	linux64_call(LINUX64_CALL_FAULT, fault);
+	linux64_fault_report(fault, 0);
+}
+
+void
+linux64_user_fault(struct linux64_x86_fault *fault)
+{
+	linux64_fault_report(fault, 1);
+}
+
+void
+linux64_user_enter(unsigned long rip)
+{
+	if (linux64_hook) {
+		linux64_call2(LINUX64_CALL_USER_ENTER, rip, 0);
+	}
 }
 
 /*
  * Where a secondary CPU starts (LINUX64_CALL_CPU_START), on that CPU's host
- * thread and in its own world. linux64_hook's caller has already installed
- * this CPU's GS base and kernel stack. TODO(stage 3): call i386_init_slave()
- * once cpu_desc_load()/GS is wired to the per-CPU world.
+ * thread and in its own world. The host passes this CPU's cpu_data_t; loading
+ * its descriptors installs the GS base that XNU's AP startup code expects, and
+ * i386_init_slave() continues through secondary_cpu_main() like a real SMP boot.
  */
 void
 linux64_cpu_entry(void *cpu_data_ptr)
 {
-	(void)cpu_data_ptr;
-	panic("linux64_cpu_entry: secondary CPU startup not ported yet");
+	cpu_data_t *cdp = (cpu_data_t *)cpu_data_ptr;
+
+	if (cdp == NULL) {
+		panic("linux64_cpu_entry: no cpu_data_t");
+	}
+	cpu_desc_load(cdp);
+	i386_init_slave();		/* never returns */
 }
 
