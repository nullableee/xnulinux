 		traptrace_index = traptrace_start(type, rip, mach_absolute_time(), regs->rbp);
 #endif
+		if (linux64_hook && (type == T_PAGE_FAULT || type == T_GENERAL_PROTECTION ||
+		    type == T_INVALID_OPCODE || type == T_STACK_FAULT)) {
+			struct linux64_x86_fault lx = {
